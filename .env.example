# Module 18: copy this file to .env in the same directory you run
# `docker compose` from (repo root, or docker/ -- docker compose reads
# .env from its own working directory). Fill in real values before
# running `docker compose -f docker/docker-compose.yml up --build`.
#
# NEVER commit a real .env file -- it's already covered by the root
# .gitignore's `.env` / `*.env` patterns.

# --- Database ---
# Fine to leave as-is for local/dev use; change for anything shared.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=clientos

# --- Required secrets: docker-compose refuses to start without these ---

# Generate with: openssl rand -base64 32
JWT_SECRET=

# Shared secret between backend and ai-service (Module 8). Generate any
# random string, e.g.: openssl rand -hex 32
INTERNAL_API_KEY=

# From aistudio.google.com/apikey. Required for chat/summary/
# recommendations/meeting-brief to return real answers. (ai-service was
# originally built against Claude/Anthropic; it now calls Gemini --
# see ai-service/app/llm/gemini_client.py.)
GEMINI_API_KEY=

# --- Optional overrides ---
JWT_EXPIRATION_MS=3600000
GEMINI_MODEL=gemini-3.6-flash

# The frontend's API base URL is baked in at BUILD time (see
# frontend/Dockerfile) -- this is correct for a single-machine deploy
# where the browser reaches the backend via the host's exposed port.
# Change it (and rebuild) if the backend is reachable at a different
# host/port, e.g. a real domain in production.
VITE_API_BASE_URL=http://localhost:8080/api
