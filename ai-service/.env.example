# Copy this file to .env and set a real value for anything beyond local dev.
# Spring Boot must send this same value as the X-Internal-Api-Key header on
# every request to this service.
INTERNAL_API_KEY=dev-internal-key

# Shared storage root for uploaded documents (Module 9), relative to this
# service's own working directory. Only valid while both services run on
# the same machine — see app/documents/paths.py.
DOCUMENT_STORAGE_DIR=../backend/storage/documents

# Chunking defaults (characters, not tokens).
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Postgres/pgvector (Module 10). Start it with:
#   docker compose -f docker/docker-compose.yml up -d
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clientos

# Local embedding model (via fastembed) — must match the vector(384)
# column in document_chunks.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Gemini (Module 11 RAG; originally built against Claude/Anthropic,
# swapped later -- see app/llm/gemini_client.py). Get a key from
# aistudio.google.com/apikey — required for /ai/chat to return real
# answers; the service starts fine without it, but chat requests will
# fail with a clear 503 until it's set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_TOKENS=4096

# Retrieval tuning (Module 11). RAG_MAX_DISTANCE is a starting point to
# tune against real data, not a fixed constant — see app/rag/pipeline.py.
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.6

# Client summary generation (Module 13).
SUMMARY_MAX_CHUNKS=40

# Recommendations (Module 15).
RECOMMEND_TOP_K=5

# Meeting-brief agent (Module 16).
AGENT_MAX_CHUNKS=40
